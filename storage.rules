rules_version = '2';

// Reglas de seguridad de Firebase Storage para Lumen.
service firebase.storage {
  match /b/{bucket}/o {

    // Fotos de perfil: cualquiera con sesión las ve; solo el dueño sube,
    // solo imágenes y de máximo 5 MB.
    match /users/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Fotos del catálogo: solo lectura desde la app.
    match /plants/{fileName} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
